# Copy this file to .env.local and adjust as needed.
#
# This chat panel talks to the dcr-assistant backend over WebSocket. It does NOT
# call any LLM directly, so no API key belongs here — the key lives in the
# backend's environment.

# WebSocket URL of the dcr-assistant backend (default: ws://localhost:8000/ws)
VITE_BACKEND_WS_URL=ws://localhost:8000/ws
